GROQ_API_KEY=
EVAL_MODEL=llama-3.1-8b-instant

# Groq free tier: 30 requests/min, 6,000 tokens/min per organization.
# Defaults below sit just under both as a safety margin. Raise these if
# you're on a paid Developer tier with higher limits.
MAX_REQUESTS_PER_MINUTE=28
MAX_TOKENS_PER_MINUTE=5500
ESTIMATED_TOKENS_PER_CALL=500

# Optional — leave blank to skip Slack alerting. Create an incoming webhook
# at https://api.slack.com/messaging/webhooks and paste the URL here.
SLACK_WEBHOOK_URL=
